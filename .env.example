# Copy to .env for local development (`make run` loads it). Never commit .env.

# --- required ---------------------------------------------------------------
# Postgres connection string (matches docker-compose.yml dev database).
DATABASE_URL=postgres://oauth:oauth@127.0.0.1:5432/oauth
# Externally visible base URL, no trailing slash. Issuer = {PUBLIC_URL}/{tenant}.
PUBLIC_URL=http://localhost:8080
# 32 random bytes, standard base64. Wraps signing keys and TOTP secrets at rest
# (AES-256-GCM); losing it makes those unreadable. Generate: openssl rand -base64 32
OAUTH_MASTER_KEY=

# --- optional (defaults shown) ----------------------------------------------
# Public HTTP listener (API + SPA + probes).
LISTEN_ADDR=0.0.0.0:8080
# Prometheus /metrics listener; keep it off the public ingress.
METRICS_ADDR=0.0.0.0:9090
# Log output: text | json
LOG_FORMAT=text
# tracing filter directive (default: info,sqlx=warn), e.g. info,oauth_server=debug
RUST_LOG=info,sqlx=warn
# Signing key rotation period per tenant.
KEY_ROTATION_DAYS=90
# How long a new key sits in JWKS before it starts signing (< rotation period).
KEY_PREPUBLISH_HOURS=48
# Browser session lifetime.
SESSION_TTL_HOURS=24
# Built SPA directory served by the backend.
WEB_DIST_DIR=web/dist
