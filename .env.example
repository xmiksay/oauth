# Copy to .env for local development (`make run` loads it). Never commit .env.

# --- required ---------------------------------------------------------------
# Postgres connection string (matches docker-compose.yml dev database).
DATABASE_URL=postgres://oauth:oauth@127.0.0.1:5432/oauth
# Externally visible apex origin: scheme://host[:port], no path. Tenant `t`
# lives only at (and its issuer is) scheme://t.host[:port]; the apex itself
# just redirects to the system tenant's admin portal. Needs DNS for the apex
# and `*.host` (`*.localhost` resolves to loopback in browsers and curl).
# Dev default = the Vite dev server (`make web-dev`), which proxies the API to
# LISTEN_ADDR keeping the Host header: open http://system.localhost:5173/admin.
# Backend only (SPA from WEB_DIST_DIR): PUBLIC_URL=http://localhost:8080.
PUBLIC_URL=http://localhost:5173
# 32 random bytes, standard base64. Wraps signing keys and TOTP secrets at rest
# (AES-256-GCM); losing it makes those unreadable. Generate: openssl rand -base64 32
OAUTH_MASTER_KEY=

# --- optional (defaults shown) ----------------------------------------------
# Public HTTP listener (API + SPA + probes).
LISTEN_ADDR=0.0.0.0:8080
# Prometheus /metrics listener; keep it off the public ingress.
METRICS_ADDR=0.0.0.0:9090
# Log output: text | json
LOG_FORMAT=text
# tracing filter directive (default: info,sqlx=warn), e.g. info,oauth_server=debug
RUST_LOG=info,sqlx=warn
# Signing key rotation period per tenant.
KEY_ROTATION_DAYS=90
# How long a new key sits in JWKS before it starts signing (< rotation period).
KEY_PREPUBLISH_HOURS=48
# Browser session lifetime.
SESSION_TTL_HOURS=24
# Built SPA directory served by the backend.
WEB_DIST_DIR=web/dist
# `Secure` + `__Host-` prefix on the session and login-transaction cookies
# (default true). Set false ONLY for plain-http local development (refused
# with an https:// PUBLIC_URL).
COOKIE_SECURE=false
# Header with the client IP set by a trusted reverse proxy, e.g.
# X-Forwarded-For (its right-most entry is used: exactly one proxy hop).
# Unset = use the TCP peer address. Never set it without such a proxy.
#TRUSTED_PROXY_HEADER=X-Forwarded-For

# --- optional: email ----------------------------------------------------------
# Outgoing mail for address verification, password reset, invitations and
# security notices. Set both or neither; unset hides every email feature
# (admins then hand out one-time passwords). lettre URL, encrypted and not
# downgradable: smtps://user:pass@host (implicit TLS, port 465) or
# smtp://user:pass@host?tls=required (STARTTLS, port 587). Plain smtp:// (or
# ?tls=opportunistic) only to a loopback host and without credentials — the
# dev sink: Mailpit from `make dev-db`, inbox at http://localhost:8025.
SMTP_URL=smtp://localhost:1025
# Bare From address; the display name is the tenant's name.
SMTP_FROM=noreply@localhost

# --- optional: Telegram ------------------------------------------------------
# A bot (create it with @BotFather) for sign-in codes (an MFA method) and
# security notices. Set token, username and webhook secret together or none;
# unset hides every Telegram feature. After setting them, register the webhook
# once: `make telegram-webhook` (Telegram calls {PUBLIC_URL}/telegram/webhook,
# so PUBLIC_URL must be reachable from the internet over https on 443, 80, 88
# or 8443 — local dev needs a tunnel). See docs/telegram.md.
# Unsetting them later fails closed: users who linked Telegram keep it as a
# required second factor (startup warns how many) until an admin resets
# their MFA or the bot is configured again.
# Bot token from BotFather (a credential: Secret in Kubernetes).
#TELEGRAM_BOT_TOKEN=123456789:AA...
# The bot's @username, without the @.
#TELEGRAM_BOT_USERNAME=my_idp_bot
# Telegram echoes it on every webhook call; 1-256 of A-Z a-z 0-9 _ -.
# Generate: openssl rand -hex 32
#TELEGRAM_WEBHOOK_SECRET=
# Bot API origin (https; http only to a loopback host, e.g. a fake API).
#TELEGRAM_API_URL=https://api.telegram.org
